   "relevant": true,
   "bank": "RBA",
   "speaker": "Michele Bullock",
   "role": "Governor",
   "kind": "remark",
   "paraphrase": "Governor Bullock said the Middle East conflict has so far had a relatively limited effect on economic activity.",
