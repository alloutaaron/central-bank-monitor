   "relevant": true,
   "bank": "RBA",
   "speaker": "Michele Bullock",
   "role": "Governor",
   "kind": "remark",
   "paraphrase": "Governor Bullock said tightening takes time to filter through, so the effect of recent rate rises has yet to fully show.",
