   "decision_level": ""
  },
  {
   "id": "tg-firstsquaw-188050",
   "relevant": true,
   "bank": "RBNZ",
   "speaker": "",
   "role": "MPC minutes",
   "kind": "other",
   "paraphrase": "New Zealand's recovery may outperform expectations, though a deteriorating global backdrop could weaken growth.",
